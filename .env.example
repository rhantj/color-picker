# LLM — 41단계부터 Claude API 다. 비우면 LLM 없이 돈다(검색 재작성 · 캐릭터 파서 · 구조/재질 고르기가 기본값으로).
# 키는 직접 넣는다. 콘솔에서 월 지출 상한을 꼭 걸어 둔다. 임베딩은 로컬 Ollama(bge-m3)라 키가 없다.
ANTHROPIC_API_KEY=
# 선택 — 기본값은 claude-haiku-4-5
# CLAUDE_MODEL=claude-haiku-4-5

# LangSmith — 비우면 아무 데도 안 보낸다. 키는 직접 넣는다.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=color-picker
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
