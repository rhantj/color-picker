# 모델 — 41단계부터 대화는 Claude API, 임베딩은 Voyage API 다. 비우면 그 기능 없이 기본 검색(1단계)으로 돈다.
# 키는 직접 넣는다. 콘솔에서 월 지출 상한을 꼭 걸어 둔다 — 공개 사이트라 남이 호출을 일으킬 수 있다.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# 선택 — 기본값은 claude-haiku-4-5 / voyage-4
# CLAUDE_MODEL=claude-haiku-4-5
# VOYAGE_MODEL=voyage-4

# LangSmith — 비우면 아무 데도 안 보낸다. 키는 직접 넣는다.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=color-picker
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
