{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tonefirst",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "server.js"
      ],
      "port": 4173
    },
    {
      "name": "tonefirst-no-llm",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "-e",
        "process.env.PORT='4399';process.env.ANTHROPIC_API_KEY='';import('./server.js')"
      ],
      "port": 4399
    }
  ]
}
