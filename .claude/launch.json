{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tonefirst",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 4173
    },
    {
      "name": "tonefirst-no-ollama",
